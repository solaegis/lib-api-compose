-- Luacheck for LibApiCompose (ESO Lua 5.1)

std = "lua51"

ignore = {
    "212", -- unused argument
    "631", -- line too long
}

globals = {
    LibApiCompose = {
        other_fields = true,
    },
}

read_globals = {
    "d",
    "zo_callLater",
    "zo_strformat",
    "zo_strlower",
    "debug",
    "xpcall",
    "EVENT_MANAGER",
    "LibDebugLogger",
    "_G",
    "pcall",
    "unpack",
    "select",
    "GetItemId",
    "GetItemInfo",
    "GetItemUniqueId",
    "Id64ToString",
    "GetItemDisplayQuality",
    "GetItemRequiredLevel",
    "GetItemRequiredChampionPoints",
    "IsItemBound",
    "IsItemStolen",
    "GetBagSize",
    "GetNextVirtualBagSlotId",
    "GetItemLink",
    "GetItemType",
    "GetItemName",
    "GetItemFunctionalQuality",
    "GetItemQuality",
    "GetItemActorCategory",
    "GetSlotStackSize",
    "GetItemTrait",
    "GetItemLinkTraitType",
    "GetItemLinkSetInfo",
    "GetItemLinkEnchantInfo",
    "GetItemLinkIcon",
    "GetItemLinkOnUseAbilityInfo",
    "CanItemLinkBeTraitResearched",
    "CanItemBeMarkedAsJunk",
    "IsItemJunk",
    "IsItemPlayerLocked",
    "GetCollectibleName",
    "GetCollectibleNickname",
    "GetCollectibleIcon",
    "GetCollectibleInfo",
    "GetCollectibleCategoryType",
    "IsCollectibleUnlocked",
    "IsCollectibleActive",
    "GetTotalCollectiblesByCategoryType",
    "GetCollectibleIdFromType",
    "GetActiveCollectibleByType",
    "HasActiveCompanion",
    "GetActiveCompanionDefId",
    "GetCompanionCollectibleId",
    "GetSlotType",
    "GetSlotBoundId",
    "GetSlotName",
    "GetSlotTexture",
    "GetSlotItemCount",
    "IsSlotUsable",
    "GetString",
    "LINK_STYLE_DEFAULT",
    "ITEMTYPE_WEAPON",
    "ITEMTYPE_ARMOR",
    "ITEMTYPE_GLYPH_ARMOR",
    "ITEMTYPE_GLYPH_JEWELRY",
    "ITEMTYPE_GLYPH_WEAPON",
    "ITEM_TRAIT_TYPE_NONE",
    "ITEM_TRAIT_TYPE_WEAPON_INTRICATE",
    "ITEM_TRAIT_TYPE_ARMOR_INTRICATE",
    "ITEM_TRAIT_TYPE_JEWELRY_INTRICATE",
    "GAMEPLAY_ACTOR_CATEGORY_PLAYER",
    "GAMEPLAY_ACTOR_CATEGORY_COMPANION",
    "COLLECTIBLE_CATEGORY_TYPE_COMPANION",
    "HOTBAR_CATEGORY_PRIMARY",
    "HOTBAR_CATEGORY_BACKUP",
    "HOTBAR_CATEGORY_QUICKSLOT_WHEEL",
    "ACTION_TYPE_COLLECTIBLE",
    "ACTION_TYPE_NOTHING",
    "ACTION_BAR_UTILITY_BAR_SIZE",
    "BAG_WORN",
    "BAG_VIRTUAL",
}

-- Test harness: defines ESO stubs and test DSL globals.
files["tests/**/*.lua"] = {
    allow_defined_top = true,
    globals = {
        "_G",
        "describe",
        "it",
        "assertEqual",
        "assertTruthy",
        "assertFalsy",
        "mock",
        "LibDebugLogger",
        "zo_strformat",
        "zo_strlower",
        "BAG_BACKPACK",
        "ITEMTYPE_POTION",
        "COLLECTIBLE_CATEGORY_TYPE_MOUNT",
        "ACTION_TYPE_ITEM",
        "EVENT_COLLECTIBLES_UNLOCK_STATE_CHANGED",
        "EVENT_COLLECTIBLE_UPDATED",
    },
}

-- Standalone tooling scripts (plain Lua, run on the host).
files["scripts/**/*.lua"] = {
    std = "lua51+lua52+lua53",
}
